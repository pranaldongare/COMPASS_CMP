# The addresses of this installation. Copy to `.env` (never committed).
# The API and both frontends read it and build every link from it.
#
# Write only http://<ip>. Ports are added for you: console 3000, portal 3001,
# API 8000.

# Everything on one machine: this line is all you need.
APP_BASE_URL=http://localhost

# A part on a different machine: add only the lines that differ.
# CONSOLE_URL=http://<console-ip>
# PORTAL_URL=http://<portal-ip>
# API_URL=http://<api-ip>

# Rarely needed: a different port (CONSOLE_PORT, PORTAL_PORT, API_PORT), or an
# https name, which is used exactly as written.
