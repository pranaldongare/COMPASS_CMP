# The one place this machine's address is written.
#
# Copy to `.env` (never committed). The API and both frontends read it and
# build every address from it: the links in emails and texts, the console's
# link to the portal and back, the SSO return address and the allowed origins.
# When the machine's IP changes, change APP_BASE_URL and restart the API, the
# worker, the console and the portal.

# How people reach this machine: http://<ip> or https://<name>.
# No port and no path.
APP_BASE_URL=http://localhost

# Where each part listens. The frontends' ports are also in their start
# commands (frontend/console: 3000, frontend/portal: 3001); keep them the same.
CONSOLE_PORT=3000
PORTAL_PORT=3001
API_PORT=8000

# To give one address by name instead (a deployment with a name per part),
# set it in that part's own env file and it wins over what is built here:
#   backend/api/.env        PUBLIC_BASE_URL, CONSOLE_BASE_URL, SSO_REDIRECT_URL, CORS_ORIGINS
#   frontend/console/.env.local   NEXT_PUBLIC_SUBJECT_PORTAL_URL, API_ORIGIN, DEV_ORIGINS
#   frontend/portal/.env.local    NEXT_PUBLIC_STAFF_PORTAL_URL, API_ORIGIN, DEV_ORIGINS
