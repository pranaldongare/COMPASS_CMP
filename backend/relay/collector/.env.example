# The collector's settings (ADR 0035): /etc/compass/relay-collector.env,
# inside. Every one is read once at start (common/src/cmp_relay/config.py,
# collector/src/cmp_relay/collector_config.py); a missing or malformed one
# stops the process with a sentence naming it.
#
# It holds no secret value: the collector's private key and the ingress secret
# are files, named here by path. The bridge's file is bridge/.env.example; the
# settings under "both sides" are in each file, with the same values.
#
# Lines beginning `#local:` are the values for this machine, against the moto
# emulator on 127.0.0.1:5000 (`python -m cmp_relay.provision` prints them with
# the real queue URLs filled in).
#
# Both hosts must keep their clocks by NTP: the bridge on Amazon Time Sync,
# the collector on the organisation's internal time server. The bridge stamps
# each deadline with its clock; the collector measures it on AWS's clock (the
# timestamps SQS puts on each message) and logs relay.clock_skew when its own
# clock is more than 1 s off (README, "Network requirements for the collector").

# =================================================================== both sides

# local | test | staging | production (default production). local and test are
# the only values that allow RELAY_ENDPOINT_URL and RELAY_ALLOW_DEV_ROUTES.
RELAY_ENVIRONMENT=production
#local: RELAY_ENVIRONMENT=local

# AWS region (default ap-south-1).
RELAY_REGION=ap-south-1

# A local emulator only (moto, LocalStack). Unset on AWS; refused in staging
# and production.
#local: RELAY_ENDPOINT_URL=http://127.0.0.1:5000

# The request queue (stack output RequestQueueUrl).
RELAY_REQUEST_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/111122223333/cmp-relay-production-requests
#local: RELAY_REQUEST_QUEUE_URL=http://127.0.0.1:5000/123456789012/cmp-relay-local-requests

# The bucket for bodies over 256 KiB (stack output BodiesBucketName).
RELAY_BUCKET=cmp-relay-production-bodies-111122223333
#local: RELAY_BUCKET=cmp-relay-local-bodies

# Cookies that may cross, comma-separated. Must match the API's COOKIE_NAME,
# CSRF cookie, HOLDER_TICKET_COOKIE and the SSO sign-in's pending-employee
# cookie (cmp_sso_pending, ADR 0034).
RELAY_COOKIE_NAMES=cmp_session,cmp_csrf,cmp_ticket,cmp_sso_pending

# The CSRF header's name, as the portal sends it.
RELAY_CSRF_HEADER=X-CSRF-Token

# true only with RELAY_ENVIRONMENT=local: lets GET /dev/codes and
# /dev/seed-accounts cross, for the portal's development code popup.
#local: RELAY_ALLOW_DEV_ROUTES=true

# Credentials. On AWS: none here (the bridge uses the instance role; the
# collector uses IAM Roles Anywhere through AWS_CONFIG_FILE, set in its unit).
# Against the emulator any pair works.
#local: AWS_ACCESS_KEY_ID=testing
#local: AWS_SECRET_ACCESS_KEY=testing

# ======================================================== the collector (inside)

# File holding the collector's private key, base64 (keys generate). 0600.
RELAY_COLLECTOR_PRIVATE_KEY_FILE=/etc/compass/relay/collector.key
#local: RELAY_COLLECTOR_PRIVATE_KEY_FILE=keys/collector.key

# Optional: the key being rotated out, so requests sealed to it still open.
#RELAY_COLLECTOR_PREVIOUS_KEY_FILE=/etc/compass/relay/collector.previous.key

# The API.
RELAY_API_ORIGIN=http://127.0.0.1:8000

# File holding the secret the collector sends as X-CMP-Relay-Key; the API opens
# sealed values in a relayed reply only when it matches the API's own
# RELAY_INGRESS_KEY. At least 32 characters (keys ingress-key makes 48). 0600.
RELAY_INGRESS_KEY_FILE=/etc/compass/relay/ingress.key
#local: RELAY_INGRESS_KEY_FILE=keys/ingress.key

# Every reply queue a reply may be sent to, comma-separated (stack output
# ReplyQueueUrls). A request naming any other is dropped.
RELAY_REPLY_QUEUE_URLS=https://sqs.ap-south-1.amazonaws.com/111122223333/cmp-relay-production-replies-a,https://sqs.ap-south-1.amazonaws.com/111122223333/cmp-relay-production-replies-b
#local: RELAY_REPLY_QUEUE_URLS=http://127.0.0.1:5000/123456789012/cmp-relay-local-replies-a,http://127.0.0.1:5000/123456789012/cmp-relay-local-replies-b

# Requests handled at once (1-64, default 8).
RELAY_WORKERS=8

# A write (POST, PUT, PATCH, DELETE) is started only with this many seconds
# left before its deadline (default 18); otherwise 503 deadline_too_close.
# Checked before the write's message is deleted and again just after, so a
# slow delete cannot start a write too late. Must stay well under the bridge's
# RELAY_DEADLINE_S: the difference (25 - 18 = 7 s by default) is all the time
# a write has to be collected.
RELAY_WRITE_BUDGET_S=18
