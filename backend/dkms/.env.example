# Copy to .env. Nothing here is a default you may ship: the service refuses to
# start in a non-local environment on the development key.

ENVIRONMENT=local

# The root secret every data-type key is derived from. 32 bytes, base64.
# Generate one with:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
DKMS_MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS0zMi1ieXRlcy1sb25nISE=

# Which key version new ciphertext is written under. Older versions stay
# readable, so rotation is: add the new key, raise this, re-encrypt at leisure.
DKMS_KEY_VERSION=1

# Retired keys, so what they wrote can still be read. JSON object of
# version -> base64 key. Empty until you rotate for the first time.
DKMS_PREVIOUS_KEYS={}

# Which implementation does the encrypting.
#   local - the scheme shipped with this service: AES-256-GCM under keys derived
#           from DKMS_MASTER_KEY, one per data type. The default, and what runs
#           until a vendor library exists.
#   sdk   - a vendor DKMS client. Nothing is imported unless this is set, and a
#           deployment that sets it and cannot load the library fails at
#           startup rather than on the first record of the first batch.
DKMS_PROVIDER=local

# Only read when DKMS_PROVIDER=sdk: the module to import and the callable in it
# that builds the client. The client must expose encrypt, decrypt,
# encrypt_bytes and decrypt_bytes; app/dkms/sdk.py adapts anything that does.
DKMS_SDK_MODULE=dkms
DKMS_SDK_FACTORY=get_client

# Threads in the pool that does the encrypting. OpenSSL releases the GIL, so
# these are real parallelism. 0 means "as many as the machine has cores".
DKMS_POOL_WORKERS=0

# Records handed to one worker at a time. Small enough that the work spreads
# across the pool, large enough that the hand-off is not most of the cost.
DKMS_CHUNK_SIZE=64

# Refuse a request larger than this many records, rather than melting.
DKMS_MAX_RECORDS=5000

# Where the service listens. Loopback by default: its callers are the platform
# API and the two portals' server sides, all of which are on this machine in
# development and behind the same boundary in a deployment.
#
# When a caller is on another machine - a portal whose DKMS_URL names this
# host by IP - loopback is unreachable and every decrypt answers 503. Bind
# the interface the callers reach, or every interface, and put a firewall
# rule in front of it: the service authenticates nobody.
#   HOST=0.0.0.0
HOST=127.0.0.1
PORT=32688

# Who may call it *from a browser*. Empty, and deliberately so: no browser
# should ever hold a decryption oracle. A page that needs plaintext asks its own
# portal's server, which asks this. Fill this in only if you have decided
# otherwise and written down why.
CORS_ORIGINS=
