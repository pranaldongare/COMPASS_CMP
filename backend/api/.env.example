# Copy to .env for local development. Never commit a real .env.
# In production these come from a secret manager (AWS Secrets Manager, Vault,
# Parameter Store), not from a file on disk.

ENVIRONMENT=local          # local | test | staging | production
DEBUG=false

# ---------------------------------------------------------------- database
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=cmp
POSTGRES_USER=cmp
POSTGRES_PASSWORD=cmp
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_STATEMENT_TIMEOUT_MS=15000

# ------------------------------------------------------------------- redis
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ---------------------------------------------------------------- security
# Production refuses to start if this is left at a development value.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=local-development-secret-key-not-for-production-use

SESSION_TTL_S=28800          # absolute lifetime: 8 hours
SESSION_IDLE_TIMEOUT_S=1800  # sliding idle timeout: 30 minutes
COOKIE_SECURE=false          # true in anything served over HTTPS
COOKIE_SAMESITE=lax

# R-AUT-03. Keyed on the account, not the address: an attacker rotates addresses.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_S=1800
LOGIN_LOCKOUT_DURATION_S=1800
# One address guessing at many accounts: failed attempts, across accounts, at
# sign-in, code sign-in and password reset. Successes do not count.
AUTH_FAILURES_PER_ADDRESS=30
AUTH_FAILURES_WINDOW_S=900

OTP_TTL_S=600
OTP_MAX_VERIFY_ATTEMPTS=5
# How long the code in a staff invitation lasts. Hours, because nobody is
# waiting at a code box for this one: an administrator provisions the account
# while they have the details to hand, and its owner reads the message when
# they next look. An expired one is replaced by "Forgotten your password?".
STAFF_INVITE_TTL_H=48
# Every staff role steps up with an emailed code. The data subject is not
# listed: her sign-in is a one-time code already. Narrow this only if you
# are prepared to answer for it.
MFA_REQUIRED_ROLES=dpo,admin,dco,dco_admin,rco,rnd_user,breach_holder

# The data principal's portal (frontend/portal, port 3001): the base of every
# link put in a message to a person - accept a nomination, withdraw, sign in.
# Not the console: it has none of those pages, and the link would be a 404.
PUBLIC_BASE_URL=http://localhost:3001
# The staff console (frontend/console, port 3000): the base of every link put
# in a message to staff - a ticket, a request, the password reset page.
CONSOLE_BASE_URL=http://localhost:3000

# -------------------------------------------------------------------- CORS
# Comma-separated. Must be explicit in production - "*" is refused at startup.
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=*

# ----------------------------------------------------------------- uploads
MAX_UPLOAD_BYTES=26214400    # 25 MB, enforced by the application's body-limit middleware.
UPLOAD_ROOT=./var/uploads

# ----------------------------------------------------------------- logging
LOG_LEVEL=INFO
LOG_JSON=true                # false for human-readable output in a terminal

# ------------------------------------------------------------------ rights
# "D": the response period published for a rights request, in days. Rule 14 sets
# ninety as the outer limit. Copied onto each request at receipt.
RIGHTS_RESPONSE_PERIOD_DAYS=90
GRIEVANCE_RESPONSE_PERIOD_DAYS=90
RIGHTS_ACKNOWLEDGE_WITHIN_DAYS=2   # D0 + 2
RIGHTS_TICKETS_WITHIN_DAYS=5       # D0 + 5
RIGHTS_COLLATE_BEFORE_DAYS=5       # D - 5
RIGHTS_DOWNLOAD_TTL_DAYS=30        # how long a released response stays downloadable
RIGHTS_UNVERIFIED_CLOSE_DAYS=7     # public-form requests that never verified
NOMINATION_ACCEPT_TTL_DAYS=30

# ------------------------------------------------------------------ breach
# The internal target for a duty Rule 7 says is due "without delay", in hours
# from awareness. The Rule sets no hours; the number is Legal's and the
# Programme's to choose. Left unset, the breach register shows the time
# elapsed and flags nothing.
# BREACH_WITHOUT_DELAY_TARGET_HOURS=
# Internal policy: the organisation's board is told within this many minutes of
# an incident's being first noticed. Stored as each incident's due time when it
# is logged; a change moves nothing already running.
BREACH_ORG_BOARD_MINUTES=30
# Who a breach ticket may go to: internal staff, recognised by these email
# domains (comma-separated), checked for every assignee and every colleague
# they add. Production refuses to start with it empty or only cmp.local.
# The same list decides how a rights ticket's holder is reached (0049): an
# internal address gets a console login, any other a link on the portal.
BREACH_TICKET_EMAIL_DOMAINS=cmp.local
# How long an outside holder's ticket stays open in its browser after the
# one-time code (seconds), and the cookie that holds it.
# HOLDER_TICKET_SESSION_S=3600
# HOLDER_TICKET_COOKIE=cmp_ticket

# ---------------------------------------------------------------- external
ORGANISATION_NAME=COMPASS       # how messages name the organisation ({organisation})
EXTERNAL_HTTP_TIMEOUT_S=10   # never infinite

# ------------------------------------------------------------------- email
# Five settings, and nothing else. docs/email/README.md explains them;
# docs/email/messages.md lists every email the platform sends.
#
# SMTP_SERVER empty: emails are written to var/outbox.log (and laid out in
# var/outbox-html/) instead of being sent - local and test only.
# SMTP_PORT decides the connection: 465 = SSL, 587 = STARTTLS, 25 = plain relay.
# SMTP_USERNAME / SMTP_PASSWORD empty: no login.
#
# Test the server: .venv/bin/python scripts/send_test_email.py --to <you>
SMTP_SERVER=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=privacy@example.org

# -------------------------------------------------------------- transports
# Where SMS and files go. SMS defaults to `console`, which appends to
# var/outbox.log in local/test and REFUSES to send anywhere else; production
# refuses to start unless it is set to a delivering transport.

SMS_TRANSPORT=console        # console | http | null
# The http transport POSTs {"to","body","from"} as JSON with a bearer token to
# an https gateway of your choosing; put a provider-specific adapter in front.
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_HTTP_SENDER=

STORAGE_BACKEND=local        # local | object (object is a stub; see docs)

# ----------------------------------------------------------------- DKMS
# The key service (backend/dkms). Personal fields are encrypted through it on the
# way into the database; the portals decrypt through their own server side.
DKMS_URL=http://localhost:32688
DKMS_TIMEOUT_S=5
DKMS_BATCH_SIZE=500
# On: every write of a personal column goes through the key service, and the
# portals decrypt. Rows written before it was on are plaintext and still read.
# Set false only against a database you want to keep plaintext; production
# refuses to start with it off.
# Read by the API *and* by the worker, which are separate processes with
# separate environments. The worker is the one that opens the address a
# sign-in code is sent to, so with this false there it silently sends
# nothing - it used to fail with "'mfa_code' is not sent by sms", which named
# neither the cause nor the cure. It now says so plainly, but the setting
# still has to be true in both.
DKMS_ENABLED=true
# The key the blind indexes of sealed lookup columns (email, mobile, username,
# contact) are computed under. Separate from SECRET_KEY: rotating sessions
# must not change every index. 32+ bytes; production refuses the default.
# Must equal the key service's DKMS_HASH_KEY: both compute the same hashes,
# the platform locally so that sign-in survives the service being down, the
# service so that any other caller can ask for one (POST /search).
BLIND_INDEX_KEY=dev-only-blind-index-key-32-bytes-long!

# ----------------------------------------------------------- development only
# Show each one-time code in a popup in the browser tab that asked for it -
# no other tab or machine sees it - so a local sign-in can be finished without
# reading var/outbox.log, including from a phone or another machine opening
# the portal by IP. Needs NEXT_PUBLIC_DEV_SHOW_CODES=true in the portals too.
# Refused at startup outside ENVIRONMENT=local/test: a code shown on the screen
# that asks for it proves nothing about who holds the phone.
DEV_SHOW_CODES=false
# With DEV_SHOW_CODES on, the console's sign-in page lists these logins that
# still have the seed password, with the password and a button that fills the
# form. A changed password, an inactive account or a login not listed here is
# never shown. The defaults are the role logins (admin@, dpo@, dcoadmin@,
# dco@, rco@, rnd@cmp.local) and scripts/seed_demo.py's staff; set these only
# to change them.
# DEV_SEED_PASSWORD=SeedPassw0rd!2026
# DEV_SEED_LOGINS=admin@cmp.local,dpo@cmp.local
