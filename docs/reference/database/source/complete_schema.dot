digraph Schema {
graph [rankdir=LR, bgcolor="#F7FAFC", pad="0.5", nodesep="0.42", ranksep="1.25", splines=polyline, concentrate=false, compound=true, newrank=true, outputorder=edgesfirst, fontname="Helvetica", labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="30" COLOR="#142C44"><B>COMPASS / COMPLETE SCHEMA</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#526477">Migration 0049 / 58 tables / 161 foreign keys / source c59d9da</FONT><BR ALIGN="LEFT"/><BR ALIGN="LEFT"/><FONT POINT-SIZE="12" COLOR="#334155">FK arrow: child column to referenced key   |   Solid = required FK; dashed = nullable FK; dotted = view dependency</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="12" COLOR="#334155">PK = primary key; FK = foreign key; UQ = member of unique constraint (possibly composite); ? = nullable column</FONT>>];
