                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Acknowledgement": {
        "properties": {
          "accepted": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Accepted"
          },
          "duplicates": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Duplicates"
          }
        },
        "type": "object",
        "required": [
          "accepted"
        ],
        "title": "Acknowledgement"
      },
      "Action": {
        "type": "string",
        "enum": [
          "restrict",
          "lift_restriction",
          "erase",
          "redact",
          "hold",
          "release_hold"
        ],
        "title": "Action"
      },
      "AssetEvent": {
        "properties": {
          "event_id": {
            "type": "string",
